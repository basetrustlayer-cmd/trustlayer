DATABASE_URL="postgresql://trustlayer:trustlayer@localhost:5432/trustlayer_dev?schema=public"
REDIS_URL="redis://localhost:6379"
AUTH_SECRET="replace-with-a-random-64-character-secret"
NODE_ENV="development"

STORAGE_PROVIDER="r2"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="trustlayer-documents"
S3_ACCESS_KEY_ID="replace-with-r2-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
S3_PUBLIC_BASE_URL=""

API_GATEWAY_URL="http://localhost:3000"

STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_SUCCESS_URL="http://localhost:3001/billing?success=1"
STRIPE_CANCEL_URL="http://localhost:3001/billing?canceled=1"

# Cron jobs
CRON_SECRET=change-me-to-a-long-random-cron-secret
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Email notifications
EMAIL_PROVIDER="audit"
EMAIL_FROM="TrustLayer <notifications@trustlayer.io>"
RESEND_API_KEY="re_replace_me"

# Outbound webhook signing
WEBHOOK_SIGNING_SECRET="replace-with-a-random-64-character-webhook-secret"

# Event bus / Redpanda
EVENT_BUS_PROVIDER="audit"
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="trustlayer-api-gateway"
KAFKA_CONSUMER_CLIENT_ID="trustlayer-event-consumer"
KAFKA_CONSUMER_GROUP_ID="trustlayer-event-consumers"
KAFKA_MARKETPLACE_TOPIC="trustlayer.marketplace.events"
EVENT_CONSUMER_ENABLED="false"

# Webhook retry engine
WEBHOOK_RETRY_ENABLED="false"
WEBHOOK_MAX_ATTEMPTS="5"
WEBHOOK_RETRY_INTERVAL_MS="60000"

# Fraud graph / Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="trustlayer"
